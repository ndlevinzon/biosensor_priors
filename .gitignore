# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.env

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Docs
docs/_build/
docs/api/_autosummary/

# Data / runtime artifacts
# Keep raw experimental + construct reference inputs tracked.
data/processed/*
!data/processed/.gitkeep
!data/processed/splits/
data/processed/splits/*
!data/processed/splits/.gitkeep
data/structures/*
!data/structures/.gitkeep
data/physics/*
!data/physics/.gitkeep
data/rounds/*
!data/rounds/.gitkeep
manifests/*
!manifests/.gitkeep
!manifests/stage0_manifest.json
outputs/*
!outputs/.gitkeep

# Large model weights (RF3 / Foundry checkpoints). Install under weights/
# on CHPC; never commit. Example:
#   foundry install base-models --checkpoint-dir "$PWD/weights/rf3"
# Then set ckpt_path in configs/structures.yaml / rf3_physics.yaml.
weights/*
!weights/.gitkeep
*.ckpt
*.pt
!**/tests/**/*.pt

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
